# Copy to root.local.env (gitignored) and fill in your own TV. Read the firmware string on the TV:
# Settings > Support > About This TV. TV_BUILD is the date in /proc/target_version (the part after "RELEASE_").
TV_IP=192.0.2.50
TV_MODEL=TQ00LS03BGUXXC
TV_FIRMWARE='T-PTMDEUC-0000.0, BT - S'
TV_BUILD=20260101
